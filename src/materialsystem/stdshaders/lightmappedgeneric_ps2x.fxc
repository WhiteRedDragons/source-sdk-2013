// STATIC: "DISTANCEALPHAMODE"			"0..3"	// 3
// STATIC: "SELFILLUM"					"0..1"	// 1
// STATIC: "ENVMAPMODE"					"0..4"	// 4 - Use 8 for PCC
// STATIC: "WARPLIGHTING"				"0..1"	// 1
// STATIC: "BUMPMODE"					"0..8"	// 8 - >4 is $NoDiffuseBumpLighting
// STATIC: "DETAILTEXTUREMODE"			"0..4"	// 4
// STATIC: "SEAMLESS_BUMPMASK"			"0..2"	// 2
// STATIC: "BASETEXTURE2_MODE"			"0..3"	// 3
// STATIC: "BLENDINGMODE"				"0..3"	// 3

// Dead Feature: "FLASHLIGHT"					"0..1"	[ps20b] [XBOX]
// Dead Feature: "RELIEF_MAPPING"				"0..0"	[ps20b]
// Dead Feature: "NORMAL_DECODE_MODE"			"0..0"	[XBOX]
// Dead Feature: "NORMAL_DECODE_MODE"			"0..0"	[PC]
// Dead Feature: "NORMALMASK_DECODE_MODE"		"0..0"	[XBOX]
// Dead Feature: "NORMALMASK_DECODE_MODE"		"0..0"	[PC]
// Dead Feature: "LIGHTING_PREVIEW"				"0..0"	[XBOX]
// Dead Feature: "WRITE_DEPTH_TO_DESTALPHA"		"0..0"	[ps20b] [XBOX]
// Dead Feature: "LIGHTING_PREVIEW"				"0..2"	[PC]

// WRITEWATERFOGTODESTALPHA and WRITE_DEPTH_TO_DESTALPHA
// Could be combined to a single Dynamic since they are mutually exlusive
// You can only write one thing to Destination Alpha!
// DYNAMIC: "FASTPATH"					"0..2" // 2 is fastpath for envmapcontrast
// DYNAMIC: "WRITEWATERFOGTODESTALPHA"	"0..1"
// DYNAMIC: "PIXELFOGTYPE"				"0..2"
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"	"0..1"	[ps20b] [PC]
// DYNAMIC: "BICUBIC_LIGHTMAP"			"0..1"	[ps20b]

// Skip Distance Alpha related Combos first, since theres a ton of them
// Make this separate Statements so it can skip the skips after they are done
// I also made it skip BumpMask, not supported with BumpMaps Anyways..
//	SKIP: ($DISTANCEALPHAMODE != 0 && $SELFILLUM)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $WARPLIGHTING)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $BUMPMODE != 0)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $DETAILTEXTUREMODE != 0)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $SEAMLESS_BUMPMASK != 0)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $BASETEXTURE2_MODE != 0)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $BLENDINGMODE != 0)
//	SKIP: ($DISTANCEALPHAMODE != 0 && $FASTPATH == 0)

//	Selfillum orders first, so skip $basealphaenvmapmask combos and BumpMask
//	SKIP: ($SELFILLUM && $ENVMAPMODE == 2)
//	SKIP: ($SELFILLUM && $ENVMAPMODE == 6)
//	SKIP: ($SELFILLUM && $SEAMLESS_BUMPMASK == 2)

//	No Cubemaps, no Cubemap Masking. No NormalMap, no Normal Map Alpha
//	SKIP: ($ENVMAPMODE == 0 && $BASETEXTURE2_MODE > 1)
//	SKIP: ($ENVMAPMODE == 3 && $BUMPMODE == 0)
//	SKIP: ($ENVMAPMODE == 7 && $BUMPMODE == 0)

//	Lightwarp has a ton of removed combos so lets do those next since its already coming first
//  SKIP: ($WARPLIGHTING && $BUMPMODE == 3)
//  SKIP: ($WARPLIGHTING && $BUMPMODE == 4)
//  SKIP: ($WARPLIGHTING && $BUMPMODE == 7)
//  SKIP: ($WARPLIGHTING && $BUMPMODE == 8)
//  SKIP: ($WARPLIGHTING && $DETAILTEXTUREMODE != 0)
//  SKIP: ($WARPLIGHTING && $SEAMLESS_BUMPMASK == 2)

//	BumpMask requires a $BumpMap2
//	And $NoDiffuseBumpLighting means its impossible to modulate any dp for $DetailBlendMode 10
//	Blendmode 11 should be skipped without $BumpMap, 10 is what you should be using with one.
//	SKIP: ($BUMPMODE == 3 && $SEAMLESS_BUMPMASK == 2)
//	SKIP: ($BUMPMODE == 4 && $SEAMLESS_BUMPMASK == 2)
//	SKIP: ($BUMPMODE == 7 && $SEAMLESS_BUMPMASK == 2)
//	SKIP: ($BUMPMODE == 8 && $SEAMLESS_BUMPMASK == 2)
//	SKIP: ($BUMPMODE == 0 && $DETAILTEXTUREMODE == 3)
//	SKIP: ($BUMPMODE != 0 && $DETAILTEXTUREMODE == 4)

//	No Bump2 and no Base2 means no Blending can be done!
//	SKIP: ($BUMPMODE == 0 && $BASETEXTURE2_MODE == 0 && $BLENDINGMODE != 0)

//	Shader doesn't have the Code for Blendmode 5 and 6, but that COULD be implemented now!!
//	I remapped the Static, so these skips are no longer necessary
//	deadskip : ($DETAIL_BLEND_MODE == 2)
//	deadskip : ($DETAIL_BLEND_MODE == 3)
//	deadskip : ($DETAIL_BLEND_MODE == 4)
//	deadskip : ($DETAIL_BLEND_MODE == 5)
//	deadskip : ($DETAIL_BLEND_MODE == 6)
//	deadskip : ($DETAIL_BLEND_MODE == 7)
//	deadskip : ($DETAIL_BLEND_MODE == 8)
//	deadskip : ($DETAIL_BLEND_MODE == 9)
//	deadskip : ($DETAIL_BLEND_MODE == 5)
//	deadskip : ($DETAIL_BLEND_MODE == 6)
//	Also this doesn't work with Seamless and BumpMask
//	SKIP: ($DETAILTEXTUREMODE != 0 && $SEAMLESS_BUMPMASK != 0)

//	Seamless + MaskedBlending isn't allowed
//	SKIP: ($SEAMLESS_BUMPMASK == 1 && ($BLENDINGMODE == 1 || $BLENDINGMODE == 3))

//	Replicating the Original Skips with this one
//	No BumpMask with BaseTexture2
//  SKIP: ($SEAMLESS_BUMPMASK == 2 && $BASETEXTURE2_MODE != 0)

// These are longer necessary, just here for reference purposes
//	deadskip : ($BUMPMAP == 0 && $NORMAL_DECODE_MODE == 1)
//	deadskip : ($BUMPMAP == 0 && $NORMAL_DECODE_MODE == 2)
//	deadskip : ($BUMPMAP == 0 && $NORMALMASK_DECODE_MODE == 1)
//	deadskip : ($BUMPMAP == 0 && $NORMALMASK_DECODE_MODE == 2)

//	These are only for reference, since Flashlight is xbox360 we don't actually need them
//	deadskip : ($FLASHLIGHT && $SELFILLUM)
//	deadskip : ($FLASHLIGHT && $ENVMAPMODE != 0)
//	deadskip : ($FLASHLIGHT && $WARPLIGHTING)
//	deadskip : ($FLASHLIGHT && $BUMPMODE > 4)
//	deadskip : ($FLASHLIGHT && $BASETEXTURE2_MODE > 1)

// ShiroDkxtro2: Statics were remapped, make the Shader use the original Paths again !!
// Its either one of the two, both, or none
// Making it one Static means less checks for the skip
#if (DISTANCEALPHAMODE != 0)
	#if (DISTANCEALPHAMODE == 1)
		#define OUTLINE 1
		#define SOFTEDGES 0
	#elif (DISTANCEALPHAMODE == 2)
		#define OUTLINE 0
		#define SOFTEDGES 1
	#elif (DISTANCEALPHAMODE == 3)
		#define OUTLINE 1
		#define SOFTEDGES 1
	#endif
#else
	#define OUTLINE 0
	#define SOFTEDGES 0
#endif

#if (ENVMAPMODE != 0)
	#define CUBEMAP 1

	#if (ENVMAPMODE == 2 || ENVMAPMODE == 6) 
		#define BASEALPHAENVMAPMASK 1
		#define NORMALMAPALPHAENVMAPMASK 0
		#define ENVMAPMASK 0
		
	// !BUMPMODE is skipped above
	#elif (ENVMAPMODE == 3 || ENVMAPMODE == 7)
		#define BASEALPHAENVMAPMASK 0
		#define NORMALMAPALPHAENVMAPMASK 1
		#define ENVMAPMASK 0
	#elif (ENVMAPMODE == 4 || ENVMAPMODE == 8)
		#define BASEALPHAENVMAPMASK 0
		#define NORMALMAPALPHAENVMAPMASK 0
		#define ENVMAPMASK 1
	#else
		#define BASEALPHAENVMAPMASK 0
		#define NORMALMAPALPHAENVMAPMASK 0
		#define ENVMAPMASK 0
	#endif
	
	#if (ENVMAPAMODE > 4)
		#define PARALLAXCORRECT 1
	#else
		#define PARALLAXCORRECT 0
	#endif
#else
	#define CUBEMAP 0
	#define BASEALPHAENVMAPMASK 0
	#define NORMALMAPALPHAENVMAPMASK 0
	#define ENVMAPMASK 0
	#define PARALLAXCORRECT 0
#endif

// DetailTextures are now disabled at 0 and enabled above 0 to save one static
// Shifting the Range here so we have less combos to worry about
#if (DETAILTEXTUREMODE != 0)
	#define DETAILTEXTURE 1

	#if (DETAILTEXTUREMODE == 1)
		#define DETAIL_BLEND_MODE 0
	#elif (DETAILTEXTUREMODE == 2)
		#define DETAIL_BLEND_MODE 1
	#elif (DETAILTEXTUREMODE == 3)
		#define DETAIL_BLEND_MODE 10
	#elif (DETAILTEXTUREMODE == 4)
		#define DETAIL_BLEND_MODE 11
	#else
		// This was previously the 'disabled' Value
		// So I'm setting that as the fallback instead of 0 which is mod2x
		#define DETAIL_BLEND_MODE 12
	#endif
#else
	#define DETAILTEXTURE 0
	#define DETAIL_BLEND_MODE 12
#endif

// $BumpMap, $BumpMap2, $SSBump and $NoDiffuseBumpLighting
// Combined into one Static :)
#if (BUMPMODE > 0)
	// Shader still uses the definition somewhere, so set it to 0
	#define NORMAL_DECODE_MODE 0
	#define NORMALMASK_DECODE_MODE 0

	// SSBUMP Variants  
	#if (BUMPMODE == 2 || BUMPMODE == 4 || BUMPMODE == 6 || BUMPMODE == 8)
		#define BUMPMAP 2
	#else 
		#define BUMPMAP 1
	#endif

	// $BumpMap2 Variant
	#if (BUMPMODE == 3 || BUMPMODE == 4 || BUMPMODE == 7 || BUMPMODE == 8)
		#define BUMPMAP2 1
	#else
		#define BUMPMAP2 0
	#endif

  // This means Diffuse Bumped Lighting is not desired
  #if(BUMPMODE > 4)
    #define DIFFUSEBUMPMAP 0
  #else
    #define DIFFUSEBUMPMAP 1
  #endif
#else
	#define DIFFUSEBUMPMAP 0
	#define BUMPMAP 0
	#define BUMPMAP2 0
#endif

// Can no longer disable the EnvMap on Both..
#if (BASETEXTURE2_MODE > 0)
	#define BASETEXTURE2 1

	#if (BASETEXTURE2_MODE == 2)
		#define BASETEXTURENOENVMAP 1
		#define BASETEXTURE2NOENVMAP 0
	#elif (BASETEXTURE2_MODE == 3)
		#define BASETEXTURENOENVMAP 0
		#define BASETEXTURE2NOENVMAP 1
	#else
		#define BASETEXTURENOENVMAP 0
		#define BASETEXTURE2NOENVMAP 0
	#endif
#else
	#define BASETEXTURE2 0
	#define BASETEXTURENOENVMAP 0
	#define BASETEXTURE2NOENVMAP 0
#endif

// Doing it like this removes the Seamless && BumpMask Skip
// Less Skips == Good
#if (SEAMLESS_BUMPMASK != 0)
	#if (SEAMLESS_BUMPMASK == 1)
		#define SEAMLESS 1
		#define BUMPMASK 0
	#else // == 2
		#define SEAMLESS 0
		#define BUMPMASK 1
	#endif
#else
	#define SEAMLESS 0
	#define BUMPMASK 0
#endif

#if (BLENDINGMODE != 0)
	#if (BLENDINGMODE == 1)
		#define MASKEDBLENDING 1
		#define FANCY_BLENDING 0
	#elif (BLENDINGMODE == 2)
		#define MASKEDBLENDING 0
		#define FANCY_BLENDING 1
	// (BLENDINGMODE == 3)
	#else 
		#define MASKEDBLENDING 1
		#define FANCY_BLENDING 1
	#endif
#else
	#define MASKEDBLENDING 0
	#define FANCY_BLENDING 0
#endif

// Combined these, one less Skip
#if (FASTPATH == 2)
	#define FASTPATHENVMAPCONTRAST 1
#else
	#define FASTPATHENVMAPCONTRAST 0
#endif

// In case this is used somewhere, set it to 0
#define RELIEF_MAPPING 0
#define FASTPATHENVMAPTINT 0
#define FLASHLIGHT 0

#include "lightmappedgeneric_ps2_3_x.h"